rules_version = '2';

// The trader writes with a service account, which bypasses these rules.
// The browser only reads, and only as you. Replace the email with the Google account you sign in with.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "YOUR_GOOGLE_EMAIL@gmail.com";
    }

    match /trader/{doc} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /history/{runId} {
      allow read: if isOwner();
      allow write: if false;
    }
  }
}
